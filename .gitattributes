# Normalise line endings on commit; keep working trees native.
* text=auto eol=lf

# Windows-only project files stay CRLF so Visual Studio is happy.
*.sln    text eol=crlf
*.csproj text eol=crlf
*.props  text eol=crlf
*.targets text eol=crlf
*.ps1    text eol=crlf

# POSIX hooks and patches must keep LF or they break on clone.
.githooks/* text eol=lf
*.patch     text eol=lf
*.sh        text eol=lf

# Binary-ish: never diff or normalise.
*.bin   -text -diff
*.chd   -text -diff
*.png   -text -diff
*.ttf   -text -diff
*.otf   -text -diff

# Generated C# is machine written; keep it out of language stats noise.
/generated/** linguist-generated=true
