# Normalise line endings on commit. LF everywhere, including in the working
# tree, so the checkout matches the committed blob byte for byte and git stops
# reporting "CRLF will be replaced by LF" on every commit. PowerShell, Visual
# Studio and VS Code all read LF scripts correctly on Windows.
* text=auto eol=lf

# POSIX hooks and patches must keep LF or they break on clone.
.githooks/* text eol=lf
*.patch     text eol=lf
*.sh        text eol=lf

# Binary-ish: never diff or normalise.
*.bin   -text -diff
*.chd   -text -diff
*.png   -text -diff
*.ttf   -text -diff
*.otf   -text -diff

# Generated C# is machine written; keep it out of language stats noise.
/generated/** linguist-generated=true
