diff --git a/RecompOne.Runtime/Diagnostics/ExecutionCoverage.cs b/RecompOne.Runtime/Diagnostics/ExecutionCoverage.cs
new file mode 100644
index 0000000..0ee44cd
--- /dev/null
+++ b/RecompOne.Runtime/Diagnostics/ExecutionCoverage.cs
@@ -0,0 +1,45 @@
+using System.Runtime.CompilerServices;
+
+namespace RecompOne.Runtime.Diagnostics;
+
+public sealed record FunctionVisit(string Overlay, uint Address);
+public sealed record SectorVisit(int Lba, int Bytes);
+public sealed record CoverageSnapshot(FunctionVisit[] Functions, SectorVisit[] Sectors);
+
+/// <summary>Optional observations, not a completion verdict. Entry hits do not
+/// prove every branch; sector reads do not prove an asset was decoded or played.</summary>
+public static class ExecutionCoverage
+{
+    public static volatile bool Enabled;
+    private static readonly object Gate = new();
+    private static readonly HashSet<(string Overlay, uint Address)> Functions = [];
+    private static readonly Dictionary<int, int> Sectors = [];
+
+    public static void Reset()
+    {
+        Enabled = false;
+        lock (Gate) { Functions.Clear(); Sectors.Clear(); }
+    }
+
+    [MethodImpl(MethodImplOptions.AggressiveInlining)]
+    public static void Visit(string overlay, uint address)
+    {
+        if (!Enabled) return;
+        lock (Gate) Functions.Add((overlay, address));
+    }
+
+    public static void ReadSector(int lba, int bytes)
+    {
+        if (!Enabled || lba < 0 || bytes <= 0) return;
+        lock (Gate)
+            Sectors[lba] = Math.Max(Sectors.GetValueOrDefault(lba), Math.Min(bytes, 2048));
+    }
+
+    public static CoverageSnapshot Snapshot()
+    {
+        lock (Gate)
+            return new(Functions.OrderBy(f => f.Overlay, StringComparer.Ordinal).ThenBy(f => f.Address)
+                .Select(f => new FunctionVisit(f.Overlay, f.Address)).ToArray(),
+                Sectors.OrderBy(s => s.Key).Select(s => new SectorVisit(s.Key, s.Value)).ToArray());
+    }
+}
