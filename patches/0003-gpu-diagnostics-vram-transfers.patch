+    /// <summary>
+    /// Diagnostics only: called when a render target is created or destroyed, with its rectangle.
+    /// </summary>
+    /// <remarks>
+    /// <c>GetOrCreateRt</c> is the only path that destroys a render target, and it does so when it
+    /// needs a slot at a different position or size. A room load is exactly the kind of event that
+    /// changes the display geometry, so it is exactly the kind that forces an eviction - and a
+    /// replacement is seeded from VRAM by <c>SyncRtFromVram</c>, so whether that seeding covers the
+    /// framebuffer region decides whether the eviction is harmless or wipes the buffer.
+    ///
+    /// This exists because the framebuffers were measured holding 79.6% of a frame and then falling
+    /// to zero exactly once, two frames apart, one buffer at a time - which is what an eviction looks
+    /// like and is not what a fill or a stale writeback looks like.
+    /// </remarks>
+    public static Action<string>? RtObserver;
+
+    /// <summary>
+    /// Diagnostics only: apply neutral modulation to every textured primitive, as if it were raw.
+    /// </summary>
+    /// <remarks>
+    /// Measured: not one of 206,094 in-framebuffer textured primitives is raw, so
+    /// <c>GlCore.V()</c> applies each one's vertex colour as a modulation, and their dominant colours
+    /// are 41 and 38 of 255 - about a sixth of full brightness. The shader multiplies the texel by
+    /// that and then keeps only five bits, so most texels cannot survive as anything but zero.
+    ///
+    /// Forcing neutral modulation decides between the two readings. If the room appears, the modulation
+    /// path is the defect. If it does not, the modulation is not what is losing the frame.
+    /// </remarks>
+    public static bool ForceNeutralModulation;
+
+    /// <summary>
+    /// Diagnostics only: draws classified into a render target, and draws that were not.
+    /// </summary>
+    /// <remarks>
+    /// When <c>Classify</c> returns null the draw goes into the full-VRAM texture instead of a
+    /// framebuffer-sized target, and the paths differ in <c>TargetWidth</c> - 4096 against 1280. The
+    /// asynchronous GL sampler only ever saw 1280 across a handful of samples, far too few to conclude
+    /// anything. These counters measure the ratio across every draw in the batch path.
+    /// </remarks>
+    public static long TargetDraws, NullTargetDraws;
+
+    /// <summary>
+    /// Diagnostics only: how often render targets are synced FROM VRAM versus written back TO it.
+    /// </summary>
+    /// <remarks>
+    /// Uploads and drawings reach the backend store by different routes, and only uploads have been
+    /// observed arriving: the title screen, an uploaded image, reaches 41.5% of the framebuffer while
+    /// the drawn room never appears at all. <c>WriteVram</c> writes VRAM directly and then calls
+    /// <c>SyncRtsFromVram</c>, copying VRAM into any intersecting target; drawings land in a target and
+    /// reach VRAM only through <c>Writeback</c>, which runs for dirty targets.
+    ///
+    /// If syncing happens far more often than writing back, then the guest's per-frame black upload
+    /// re-seeds the target from black VRAM before the room that was drawn into it is ever written back,
+    /// and the room is lost every frame without anything being wrong with the draws themselves.
+    /// </remarks>
+    public static long SyncRtCalls, WritebackCalls;
+
+    /// <summary>
+    /// Diagnostics only: triangles handed to the backend, and vertices handed to the driver.
+    /// </summary>
+    /// <remarks>
+    /// The render target was measured empty in the failing configuration and full of the room in the
+    /// working one, which localises the fault to rasterisation rather than to the writeback. That
+    /// leaves two possibilities, and these counters separate them: if triangles arrive and vertices
+    /// reach the driver, GL is being asked to rasterise them and is not doing it; if the counts
+    /// diverge, the vertices are being lost between the two.
+    /// </remarks>
+    public static long TrisIn, DrawsOut, VertsOut;
+
+    /// <summary>
+    /// Diagnostics only: called for every whole-region VRAM transfer - a fill, a VRAM-to-VRAM copy,
+    /// or the start of a CPU upload - with its rectangle.
+    /// </summary>
+    /// <remarks>
+    /// These three are the only operations that write a whole region of VRAM at once, and each writes
+    /// BOTH the software shadow and, through the HLE, the backend. That is what a wipe of both stores
+    /// at the same instant requires, and no draw-path operation can produce it, because draws reach
+    /// only the backend.
+    ///
+    /// This exists because the framebuffers were measured holding 79.6% and then falling to zero
+    /// exactly once, and that wipe was shown neither to be per-frame nor to coincide with any render
+    /// target event, which leaves these.
+    /// </remarks>
+    public static Action<string>? TransferObserver;
+
+    /// <summary>
+    /// Diagnostics only: the range and validity of the vertex positions handed to the driver.
+    /// </summary>
+    /// <remarks>
+    /// Three measurements have narrowed this to a very small place. The render target is empty in the
+    /// failing configuration and holds the room in the working one, so the fault is rasterisation
+    /// rather than writeback. The vertices reach the driver in both, in near-identical numbers -
+    /// 835083 against 834717 - so nothing is being lost on the way. And the draw area, which supplies
+    /// the scissor, is the full framebuffer and identical in both.
+    ///
+    /// What a vertex count does not say is whether the vertices are valid. Three vertices arriving is
+    /// not the same as three vertices forming a triangle anywhere on the target, and degenerate,
+    /// non-finite or off-surface positions would produce exactly the observed combination: correct
+    /// counts, correct clip, correct target, no pixels. These are the values themselves.
+    /// </remarks>
+    private static readonly object VertexGate = new();
+    private static long _texVerts, _texBad, _flatVerts, _flatBad;
+    private static float _texMinX = float.MaxValue, _texMaxX = float.MinValue;
+    private static float _texMinY = float.MaxValue, _texMaxY = float.MinValue;
+    private static float _flatMinX = float.MaxValue, _flatMaxX = float.MinValue;
+    private static float _flatMinY = float.MaxValue, _flatMaxY = float.MinValue;
+
+    public static void NoteVertex(bool textured, float x, float y)
+    {
+        var bad = float.IsNaN(x) || float.IsInfinity(x) || float.IsNaN(y) || float.IsInfinity(y);
+
+        lock (VertexGate)
+        {
+            if (textured)
+            {
+                _texVerts++;
+                if (bad) _texBad++;
+                else
+                {
+                    if (x < _texMinX) _texMinX = x;
+                    if (x > _texMaxX) _texMaxX = x;
+                    if (y < _texMinY) _texMinY = y;
+                    if (y > _texMaxY) _texMaxY = y;
+                }
+            }
+            else
+            {
+                _flatVerts++;
+                if (bad) _flatBad++;
+                else
+                {
+                    if (x < _flatMinX) _flatMinX = x;
+                    if (x > _flatMaxX) _flatMaxX = x;
+                    if (y < _flatMinY) _flatMinY = y;
+                    if (y > _flatMaxY) _flatMaxY = y;
+                }
+            }
+        }
+    }
+
+    public static string DescribeVertices()
+    {
+        lock (VertexGate)
+        {
+            var t = _texVerts == 0
+                ? "none"
+                : $"x {_texMinX:0.#}..{_texMaxX:0.#}, y {_texMinY:0.#}..{_texMaxY:0.#} " +
+                  $"({_texVerts} verts, {_texBad} non-finite)";
+            var f = _flatVerts == 0
+                ? "none"
+                : $"x {_flatMinX:0.#}..{_flatMaxX:0.#}, y {_flatMinY:0.#}..{_flatMaxY:0.#} " +
+                  $"({_flatVerts} verts, {_flatBad} non-finite)";
+
+            return $"  vertex positions        : textured {t}{Environment.NewLine}" +
+                   $"                            flat     {f}";
+        }
+    }
+
+    /// <summary>
+    /// Diagnostics only: whether the vertices in a flush fall inside the target that flush draws into.
+    /// </summary>
+    /// <remarks>
+    /// Vertices carry raw VRAM coordinates and the shader shifts them into the target by
+    /// <c>uPosBias = (margin - rt.X, -rt.Y)</c>. A vertex at VRAM y 240 drawn into a target at y 0
+    /// becomes target y 240, which is outside a 240-tall target and is clipped away entirely. That
+    /// would give exactly what has been measured: correct vertices, correct scissor, correct target,
+    /// no pixels - and it would explain why the presence of flat primitives changes the outcome, since
+    /// they change how draws are grouped into flushes without changing the vertices themselves.
+    /// </remarks>
+    private static readonly object FlushGate = new();
+    private static readonly Dictionary<string, long> _flushBands = [];
+
+    public static void NoteFlush(int targetVramY, float minY, float maxY, int count)
+    {
+        string band;
+        if (maxY < targetVramY || minY >= targetVramY + 240) band = "OUTSIDE the target";
+        else if (minY >= targetVramY && maxY < targetVramY + 240) band = "inside";
+        else band = "straddling";
+
+        var key = $"target y={targetVramY,-4} verts y {minY,6:0}..{maxY,-6:0} -> {band}";
+
+        lock (FlushGate)
+        {
+            _flushBands[key] = _flushBands.TryGetValue(key, out var c) ? c + 1 : 1;
+        }
+    }
+
+    public static string DescribeFlushes()
+    {
+        lock (FlushGate)
+        {
+            if (_flushBands.Count == 0) return "  flush target bands      : none recorded";
+
+            var outside = _flushBands.Where(k => k.Key.EndsWith("OUTSIDE the target")).Sum(k => k.Value);
+            var total = _flushBands.Values.Sum();
+
+            var worst = _flushBands.OrderByDescending(k => k.Value).Take(4)
+                .Select(k => $"{k.Key} x{k.Value}");
+
+            return $"  flush target bands      : {outside} of {total} flush(es) put their vertices outside the target"
+                   + Environment.NewLine + "                            "
+                   + string.Join(Environment.NewLine + "                            ", worst);
+        }
+    }
+
+    /// <summary>
+    /// Diagnostics only: draw environments as the backend receives them, by texture window and clip.
+    /// </summary>
+    /// <remarks>
+    /// The render target turned out to be filled with BLACK rather than empty: counting alpha, which
+    /// the fragment shader writes as max(stp, uSetMask), gives 718240 drawn pixels in the failing
+    /// configuration against 719920 in the working one. So rasterisation works and the fragments are
+    /// written; it is the colour that comes out black, which a colour-counting probe cannot see and
+    /// which every earlier conclusion rested on.
+    ///
+    /// That moves the question to the shader's inputs. The texture window masks and offsets the
+    /// sampled coordinates - `uv = (raw &amp; mask) | offset` - and with no window set it is the identity at
+    /// mask 0xFF, offset 0. A window left set by an earlier draw would collapse the sample to one
+    /// small, possibly black region, which would produce exactly this.
+    /// </remarks>
+    private static readonly object EnvGate = new();
+    private static readonly Dictionary<string, long> _drawEnvs = [];
+
+    public static void NoteDrawEnv(in RecompOne.Runtime.Hle.HleDrawEnv env)
+    {
+        var key = $"texwindow mask=({env.TwMaskX},{env.TwMaskY}) off=({env.TwOffX},{env.TwOffY})" +
+                  $"  clip=({env.ClipX0},{env.ClipY0})..({env.ClipX1},{env.ClipY1})" +
+                  $"  setMask={env.SetMask} checkMask={env.CheckMask}";
+
+        lock (EnvGate)
+        {
+            _drawEnvs[key] = _drawEnvs.TryGetValue(key, out var c) ? c + 1 : 1;
+        }
+    }
+
+    public static string DescribeDrawEnvs()
+    {
+        lock (EnvGate)
+        {
+            if (_drawEnvs.Count == 0) return "  draw environments       : none recorded";
+
+            var rows = _drawEnvs.OrderByDescending(k => k.Value).Take(4).Select(k => $"{k.Key} x{k.Value}");
+            return $"  draw environments       : {_drawEnvs.Count} distinct"
+                   + Environment.NewLine + "                            "
+                   + string.Join(Environment.NewLine + "                            ", rows);
+        }
+    }
+
     public static void Bind()
     {
         if (Gl == null) return;
