diff --git a/RecompOne.Runtime/Gpu/Backends/GpuGlAccess.cs b/RecompOne.Runtime/Gpu/Backends/GpuGlAccess.cs
index bc045ae..7440170 100644
--- a/RecompOne.Runtime/Gpu/Backends/GpuGlAccess.cs
+++ b/RecompOne.Runtime/Gpu/Backends/GpuGlAccess.cs
@@ -17,6 +17,63 @@ public static class GpuGlAccess
     public static int Scale => GlVram.Scale;
     public static bool Available => Gl != null && TargetFbo != 0;
 
+    /// <summary>
+    /// Diagnostics only: called when a render target is created or destroyed, with its rectangle.
+    /// </summary>
+    /// <remarks>
+    /// <c>GetOrCreateRt</c> is the only path that destroys a render target, and it does so when it
+    /// needs a slot at a different position or size. A room load is exactly the kind of event that
+    /// changes the display geometry, so it is exactly the kind that forces an eviction - and a
+    /// replacement is seeded from VRAM by <c>SyncRtFromVram</c>, so whether that seeding covers the
+    /// framebuffer region decides whether the eviction is harmless or wipes the buffer.
+    ///
+    /// This exists because the framebuffers were measured holding 79.6% of a frame and then falling
+    /// to zero exactly once, two frames apart, one buffer at a time - which is what an eviction looks
+    /// like and is not what a fill or a stale writeback looks like.
+    /// </remarks>
+    public static Action<string>? RtObserver;
+
+    /// <summary>
+    /// Diagnostics only: apply neutral modulation to every textured primitive, as if it were raw.
+    /// </summary>
+    /// <remarks>
+    /// Measured: not one of 206,094 in-framebuffer textured primitives is raw, so
+    /// <c>GlCore.V()</c> applies each one's vertex colour as a modulation, and their dominant colours
+    /// are 41 and 38 of 255 - about a sixth of full brightness. The shader multiplies the texel by
+    /// that and then keeps only five bits, so most texels cannot survive as anything but zero.
+    ///
+    /// Forcing neutral modulation decides between the two readings. If the room appears, the modulation
+    /// path is the defect. If it does not, the modulation is not what is losing the frame.
+    /// </remarks>
+    public static bool ForceNeutralModulation;
+
+    /// <summary>
+    /// Diagnostics only: draws classified into a render target, and draws that were not.
+    /// </summary>
+    /// <remarks>
+    /// When <c>Classify</c> returns null the draw goes into the full-VRAM texture instead of a
+    /// framebuffer-sized target, and the paths differ in <c>TargetWidth</c> - 4096 against 1280. The
+    /// asynchronous GL sampler only ever saw 1280 across a handful of samples, far too few to conclude
+    /// anything. These counters measure the ratio across every draw in the batch path.
+    /// </remarks>
+    public static long TargetDraws, NullTargetDraws;
+
+    /// <summary>
+    /// Diagnostics only: called for every whole-region VRAM transfer - a fill, a VRAM-to-VRAM copy,
+    /// or the start of a CPU upload - with its rectangle.
+    /// </summary>
+    /// <remarks>
+    /// These three are the only operations that write a whole region of VRAM at once, and each writes
+    /// BOTH the software shadow and, through the HLE, the backend. That is what a wipe of both stores
+    /// at the same instant requires, and no draw-path operation can produce it, because draws reach
+    /// only the backend.
+    ///
+    /// This exists because the framebuffers were measured holding 79.6% and then falling to zero
+    /// exactly once, and that wipe was shown neither to be per-frame nor to coincide with any render
+    /// target event, which leaves these.
+    /// </remarks>
+    public static Action<string>? TransferObserver;
+
     public static void Bind()
     {
         if (Gl == null) return;
