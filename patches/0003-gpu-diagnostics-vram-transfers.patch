+    private static long _wbTargetLit, _wbVramLit, _wbPairs, _blitLostContent;
+    private static readonly ushort[] _vramStrip = new ushort[320 * 32];
+
+    /// <summary>
+    /// Reads VRAM's copy of the same strip just after a writeback, to see whether the blit carried it.
+    /// </summary>
+    /// <remarks>
+    /// Everything up to the blit has been measured: the target is written into, in the correct operation
+    /// order, in both buffers, reaching 90.3% in most frames and black in 46% of them. The one step never
+    /// checked is the blit itself. Writeback blits the target into VRAM, and if that produces an empty
+    /// result then the drawing was fine all along and the composite is the fault.
+    ///
+    /// The target's strip is counted before the blit and VRAM's strip after it, at the same relative
+    /// position, so the two can be compared directly.
+    /// </remarks>
+    public static void SampleVramAfter(IGlVram vram, int x, int y, int w, int h)
+    {
+        const int stripW = 320;
+        const int stripH = 32;
+
+        if (w < stripW || h < stripH) return;
+
+        var length = stripW * stripH;
+
+        try
+        {
+            vram.ReadRect(x, y + (h - stripH) / 2, stripW, stripH, _vramStrip.AsSpan(0, length));
+        }
+        catch
+        {
+            return;
+        }
+
+        var lit = 0;
+        for (var i = 0; i < length; i++)
+        {
+            var px = _vramStrip[i];
+            if (px != 0 && px != 0x8000) lit++;
+        }
+
+        _wbPairs++;
+        _wbTargetLit += _lastTargetLit;
+        _wbVramLit += lit;
+        if (_lastTargetLit > 0 && lit == 0) _blitLostContent++;
+    }
+
+    public static string DescribeBlit()
+    {
+        if (_wbPairs == 0) return "  blit target -> vram     : no pairs sampled";
+
+        return $"  blit target -> vram     : {_wbPairs} pair(s); mean target {_wbTargetLit / _wbPairs} of {320 * 32}, " +
+               $"mean vram {_wbVramLit / _wbPairs} of {320 * 32}; " +
+               $"{_blitLostContent} where the target had content and VRAM came out empty";
+    }
+
+    /// <summary>
+    /// Reads a strip of a target and returns its non-black count, without recording anything.
+    /// </summary>
+    public static int ReadTargetStrip(uint fbo, int texW, int texH)
+    {
+        const int stripW = 320;
+        const int stripH = 32;
+
+        if (Gl is null || fbo == 0 || texW < stripW || texH < stripH) return -1;
+
+        var length = stripW * stripH * 4;
+        if (_writebackStrip.Length < length) _writebackStrip = new byte[length];
+
+        try
+        {
+            var gl = Gl;
+            gl.BindFramebuffer(FramebufferTarget.ReadFramebuffer, fbo);
+            gl.PixelStore(PixelStoreParameter.PackAlignment, 1);
+
+            // Three strips rather than one. A single strip in the middle of the target is a poor proxy
+            // for "the batch produced something": a batch that covers only part of the surface, or
+            // covers it with the middle rows empty, would read as empty while having drawn. Three
+            // widely separated rows make that far less likely, and the maximum is taken.
+            var lit = 0;
+            var best = 0;
+            for (var band = 0; band < 3; band++)
+            {
+                var y = band * (texH - stripH) / 2;
+                gl.ReadPixels(0, y, stripW, stripH, PixelFormat.Rgba,
+                    PixelType.UnsignedByte, _writebackStrip.AsSpan(0, length));
+
+                lit = 0;
+                for (var i = 0; i + 3 < length; i += 4)
+                    if (_writebackStrip[i] != 0 || _writebackStrip[i + 1] != 0 || _writebackStrip[i + 2] != 0) lit++;
+
+                if (lit > best) best = lit;
+            }
+
+            gl.BindFramebuffer(FramebufferTarget.ReadFramebuffer, 0);
+            return best;
+        }
+        catch
+        {
+            return -1;
+        }
+    }
+
+    /// <summary>
+    /// Diagnostics only: the state a batch was drawn under, against what that batch produced.
+    /// </summary>
+    /// <remarks>
+    /// Every input to the draw is now known to be identical between a frame that renders and one that
+    /// comes out black: vertices and positions, clip, classification, operation order, vertex counts,
+    /// sampled texture area, and the blit. The one thing never measured is the state GlCore applies
+    /// when it flushes, because a batch is drawn under the state of its last Begin rather than under
+    /// per-triangle state - and 285000 triangles flow through that.
+    ///
+    /// Reading the target immediately after DrawArrays couples the two directly: the state a batch ran
+    /// under, and whether the target held anything once it had run.
+    /// </remarks>
+    private static readonly object BatchGate = new();
+    private static readonly Dictionary<string, (long Batches, long Verts, long EmptyAfter, long Best)> _batches = [];
+
+    private static readonly ushort[] _texStrip = new ushort[320 * 32];
+    private static long _texEmptyWhenTargetEmpty, _texPresentWhenTargetEmpty, _texPresentWhenDrawn, _texEmptyWhenDrawn;
+
+    /// <summary>
+    /// Reads a strip of the texture area, for sampling at the moment of a draw rather than on a timer.
+    /// </summary>
+    /// <remarks>
+    /// Identical batch state, identical vertex counts and identical textures still leave the target
+    /// empty in half the frames in one configuration and never in the other - so the difference has to
+    /// be in something measured at a different instant. The texture area's end state is identical in
+    /// both, but that says nothing about what it holds when a given draw runs.
+    /// </remarks>
+    public static int ReadTextureStrip(IGlVram vram, int x, int y, int w, int h)
+    {
+        const int stripW = 320;
+        const int stripH = 32;
+
+        if (w < stripW || h < stripH) return -1;
+
+        try
+        {
+            vram.ReadRect(x, y, stripW, stripH, _texStrip.AsSpan(0, stripW * stripH));
+        }
+        catch
+        {
+            return -1;
+        }
+
+        var lit = 0;
+        for (var i = 0; i < stripW * stripH; i++)
+        {
+            var px = _texStrip[i];
+            if (px != 0 && px != 0x8000) lit++;
+        }
+
+        return lit;
+    }
+
+    public static void NoteBatchState(string state, int verts, int litAfter, int texLit)
+    {
+        if (litAfter < 0) return;
+
+        lock (BatchGate)
+        {
+            _batches.TryGetValue(state, out var s);
+            _batches[state] = (s.Batches + 1, s.Verts + verts,
+                s.EmptyAfter + (litAfter == 0 ? 1 : 0), Math.Max(s.Best, litAfter));
+
+            if (litAfter == 0) { if (texLit == 0) _texEmptyWhenTargetEmpty++; else _texPresentWhenTargetEmpty++; }
+            else { if (texLit == 0) _texEmptyWhenDrawn++; else _texPresentWhenDrawn++; }
+        }
+    }
+
+    public static string DescribeBatchStates()
+    {
+        lock (BatchGate)
+        {
+            if (_batches.Count == 0) return "  batch state             : nothing recorded";
+
+            var rows = _batches.OrderByDescending(k => k.Value.Verts).Take(6).Select(k =>
+                $"{k.Key,-42} {k.Value.Batches,5} batch(es) {k.Value.Verts,9} verts, " +
+                $"empty after {k.Value.EmptyAfter,5}, best {k.Value.Best,5}");
+
+            return "  batch state             : " + string.Join(Environment.NewLine + "                            ", rows)
+                   + Environment.NewLine
+                   + $"  texture at draw time    : target empty with texture empty {_texEmptyWhenTargetEmpty}, " +
+                     $"texture present {_texPresentWhenTargetEmpty}; target drawn with texture empty {_texEmptyWhenDrawn}, " +
+                     $"texture present {_texPresentWhenDrawn}";
+        }
+    }
+
+    /// <summary>
+    /// Diagnostics only: whether the same vertex data ever produces both outcomes.
+    /// </summary>
+    /// <remarks>
+    /// The claim that a batch which renders and a batch which comes out black are "the same" has rested
+    /// on counts and bounding ranges - the vertex count per batch, and the y range of the vertices. Both
+    /// of those can match while the contents differ, so the claim was never actually measured. Hashing
+    /// the vertex bytes at flush and grouping the hashes by outcome separates the two possibilities:
+    /// a hash seen in both states means identical input producing different results, and hashes that
+    /// partition cleanly mean the inputs genuinely differ and the fault is further back.
+    /// </remarks>
+    private static readonly object HashGate = new();
+    private static readonly Dictionary<ulong, (long Empty, long Drawn, int Verts, int InBand, float MinY, float MaxY, int TargetY, int Tris, int Degenerate, int PageMask)> _vertexHashes = [];
+    private static long _hashConsidered;
+
+    public static void NoteVertexHash(ulong hash, int count, bool empty, int inBand, float minY, float maxY, int targetY, int tris, int degenerate, int pageMask)
+    {
+        if (count < 64) return;
+
+        lock (HashGate)
+        {
+            _hashConsidered++;
+            _vertexHashes.TryGetValue(hash, out var s);
+            _vertexHashes[hash] = empty
+                ? (s.Empty + 1, s.Drawn, count, inBand, minY, maxY, targetY, tris, degenerate, pageMask)
+                : (s.Empty, s.Drawn + 1, count, inBand, minY, maxY, targetY, tris, degenerate, pageMask);
+        }
+    }
+
+    public static string DescribeVertexHashes()
+    {
+        lock (HashGate)
+        {
+            if (_vertexHashes.Count == 0) return "  vertex content hash     : nothing sampled";
+
+            var both = _vertexHashes.Count(k => k.Value.Empty > 0 && k.Value.Drawn > 0);
+            var onlyEmpty = _vertexHashes.Count(k => k.Value.Empty > 0 && k.Value.Drawn == 0);
+            var onlyDrawn = _vertexHashes.Count(k => k.Value.Empty == 0 && k.Value.Drawn > 0);
+
+            // A fingerprint of the whole set of contents, so two runs - or two configurations - can be
+            // compared on whether they saw the same vertex data at all. Both configurations reported 226
+            // distinct contents, which is only meaningful if they are the same 226.
+            var fingerprint = _vertexHashes.Keys.OrderBy(h => h).Aggregate(1469598103934665603UL,
+                (acc, h) => { acc ^= h; acc *= 1099511628211UL; return acc; });
+
+            var failing = _vertexHashes.Where(k => k.Value.Empty > 0 && k.Value.Drawn == 0)
+                .Select(k => k.Value).ToList();
+
+            // The bands a batch could legitimately draw into are the two framebuffers, y 0..240 and
+            // y 240..480. A batch whose vertices lie entirely outside both is clipped away by the
+            // scissor and produces nothing - correctly. If every never-rendering content is of that
+            // kind, then "the target was empty after the batch" was measuring correct behaviour rather
+            // than a defect, and the headline reading built on it has to be withdrawn.
+            static bool IntersectsFramebuffer((long Empty, long Drawn, int Verts, int InBand, float MinY, float MaxY, int TargetY, int Tris, int Degenerate, int PageMask) s)
+                => s.MaxY >= 0 && s.MinY < 480;
+
+            // A batch is drawn into one target, and vertices outside that target's band are clipped away
+            // by the scissor. If a never-rendering batch's vertices lie in the OTHER buffer's band, then
+            // the batch was classified into the wrong target and clipped away wholesale - which is the
+            // one mechanism that makes real geometry, inside the framebuffer, render nothing.
+            static bool MatchesItsTarget((long Empty, long Drawn, int Verts, int InBand, float MinY, float MaxY, int TargetY, int Tris, int Degenerate, int PageMask) s)
+                => s.MaxY >= s.TargetY && s.MinY < s.TargetY + 240;
+
+            // The real test, which the range-based one above cannot make: how many of the batch's
+            // vertices actually lie inside the band of the target it was drawn into. A batch that is
+            // mostly outside its target with a few degenerate triangles inside would render nothing
+            // while looking perfectly reasonable in every aggregate measured so far.
+            static bool MostlyInsideItsTarget((long Empty, long Drawn, int Verts, int InBand, float MinY, float MaxY, int TargetY, int Tris, int Degenerate, int PageMask) s)
+                => s.Verts > 0 && s.InBand * 2 >= s.Verts;
+
+            var offScreen = failing.Count(s => !IntersectsFramebuffer(s));
+            var onScreen = failing.Count(IntersectsFramebuffer);
+            var working = _vertexHashes.Where(k => k.Value.Empty == 0 && k.Value.Drawn > 0)
+                .Select(k => k.Value).ToList();
+            var wrongBand = failing.Count(s => IntersectsFramebuffer(s) && !MatchesItsTarget(s));
+            var targetsSeen = string.Join("/", failing.Select(s => s.TargetY).Distinct().OrderBy(v => v));
+            var reallyInside = failing.Count(MostlyInsideItsTarget);
+            var inBandShape = failing.Count == 0
+                ? "none"
+                : $"in-band vertices {failing.Min(x => x.InBand)}..{failing.Max(x => x.InBand)} of " +
+                  $"{failing.Min(x => x.Verts)}..{failing.Max(x => x.Verts)}; " +
+                  $"{reallyInside} have at least half their vertices inside their own target";
+
+            var failingShape = failing.Count == 0
+                ? "none"
+                : $"{failing.Count} content(s), verts {failing.Min(x => x.Verts)}..{failing.Max(x => x.Verts)}, " +
+                  $"y {failing.Min(x => x.MinY):0}..{failing.Max(x => x.MaxY):0}; " +
+                  $"{offScreen} lie wholly outside both framebuffer bands (legitimately nothing), {onScreen} intersect one, " +
+                  $"of which {wrongBand} lie in the band of the OTHER buffer and are clipped away" +
+                  $" (targets seen: {targetsSeen})" + Environment.NewLine +
+                  $"                            {inBandShape}" + Environment.NewLine +
+                  $"                            degenerate triangles - never renders: {DegenerateFraction(failing)}, " +
+                  $"renders: {DegenerateFraction(working)}";
+
+            var verdict = both > 0
+                ? "identical input produced BOTH outcomes"
+                : "inputs partition cleanly - the batches differ";
+
+            return $"  vertex content hash     : {_hashConsidered} large batch(es), {_vertexHashes.Count} distinct, " +
+                   $"set fingerprint {fingerprint:X16}" + Environment.NewLine +
+                   $"                            {both} seen in both states, {onlyEmpty} only empty, " +
+                   $"{onlyDrawn} only drawn -> {verdict}" + Environment.NewLine +
+                   $"                            the ones that never render: {failingShape}";
+        }
+    }
+
+    /// <summary>
+    /// Share of triangles that enclose no area, summed over a group of vertex contents.
+    /// </summary>
+    /// <remarks>
+    /// A degenerate primitive - three coincident or collinear vertices - rasterises nothing and looks
+    /// unremarkable in every aggregate used before this point: the vertex count is normal, the bounding
+    /// range is normal, and the vertices are genuinely inside the target. Degenerate primitives were
+    /// noticed early in this investigation and never connected to anything.
+    /// </remarks>
+    private static string DegenerateFraction(
+        List<(long Empty, long Drawn, int Verts, int InBand, float MinY, float MaxY, int TargetY, int Tris, int Degenerate, int PageMask)> xs)
+    {
+        if (xs.Count == 0) return "none";
+
+        long tris = xs.Sum(x => (long)x.Tris);
+        long deg = xs.Sum(x => (long)x.Degenerate);
+
+        var pages = xs.Select(x => x.PageMask).Aggregate(0, (a, m) => a | m);
+        var pageList = string.Join(",", Enumerable.Range(0, 16).Where(b => (pages & (1 << b)) != 0));
+
+        return $"{deg} of {tris} triangles ({(tris == 0 ? 0 : 100.0 * deg / tris):0.0}%), page X in {{{pageList}}}";
+    }
+
+    /// <summary>
+    /// Diagnostic only: when positive, flush a batch once it reaches this many vertices.
+    /// </summary>
+    /// <remarks>
+    /// Set from RE15PC_FLUSH_EVERY. Skipping the whole flat category restores the frame while skipping
+    /// no subset of it does, and the vertex contents reaching the driver differ between the failing and
+    /// working configurations - so the grouping of draws into batches is the suspect, not any primitive.
+    /// Varying the batch size is the experiment that separates those.
+    /// </remarks>
+    public static int ForceFlushEvery { get; } =
+        int.TryParse(Environment.GetEnvironmentVariable("RE15PC_FLUSH_EVERY"), out var v) && v > 0 ? v : 0;
+
+    /// <summary>Diagnostic only: draw each batch as one call per triangle. Set by RE15PC_SPLIT_DRAW.</summary>
+    public static bool SplitDraw { get; } =
+        Environment.GetEnvironmentVariable("RE15PC_SPLIT_DRAW") == "1";
+
