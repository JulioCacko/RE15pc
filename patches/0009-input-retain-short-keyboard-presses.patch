new file mode 100644
index 0000000..e79d685
--- /dev/null
+++ b/RecompOne.Runtime/Host/KeyPulseLatch.cs
@@ -0,0 +1,12 @@
+namespace RecompOne.Runtime.Host;
+
+/// <summary>Retains a host key-down across a complete guest frame, even if key-up
+/// arrives in the same event pump. Used only by the keyboard/GL thread.</summary>
+public sealed class KeyPulseLatch
+{
+    private readonly Dictionary<int, long> _until = [];
+    public void Press(int key, long completedFrame) => _until[key] = completedFrame + 2;
+    public bool IsPressed(int key, long completedFrame)
+        => _until.TryGetValue(key, out var until) && completedFrame < until;
+    public void Clear() => _until.Clear();
+}
