+    /// <summary>Diagnostics only: the most recent call targets, so an unmapped call carries context.</summary>
+    /// <remarks>
+    /// The stack trace for an unmapped call shows only Dispatcher.Call, because the recompiled caller is
+    /// inlined away, so the exception names the failing address and nothing about who asked for it.
+    /// Recompiled code reaches every function through here, so the entries preceding the failure are the
+    /// caller and the short history that led to it.
+    /// </remarks>
+    private static readonly uint[] _recentCalls = new uint[32];
+    private static int _recentCount;
+
+    private static string RecentCallTrail(uint failing)
+    {
+        var parts = new List<string>(33);
+        var n = Math.Min(_recentCount, _recentCalls.Length);
+
+        for (var i = n; i > 0; i--)
+            parts.Add($"0x{_recentCalls[(_recentCount - i) % _recentCalls.Length]:X8}");
+
+        parts.Add($"-> 0x{failing:X8}");
+        return string.Join(" ", parts);
+    }
+
