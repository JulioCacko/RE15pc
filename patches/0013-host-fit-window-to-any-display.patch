+    /// 1280x720 fallback only applies when the work area could not be read at all.
+    /// </remarks>
+    private static Vector2D<int> FillWorkArea(WorkArea? area)
+    {
+        if (area is not { } a) return new Vector2D<int>(1280, 720);
+
+        return new Vector2D<int>(
+            Math.Max(320, (int)Math.Round(a.Width * 0.90)),
+            Math.Max(240, (int)Math.Round(a.Height * 0.90)));
+    }
+
+    private static void CenterOnWorkArea(WorkArea? area, Vector2D<int> size)
+    {
+        // Position is non-nullable on the window interface, so an unknown work area
+        // means leaving the position alone rather than clearing it; the backend
+        // centres the window itself in that case.
+        if (_window == null || area is not { } a) return;
+
+        _window.Position = new Vector2D<int>(
+            a.X + Math.Max(0, (a.Width - size.X) / 2),
+            a.Y + Math.Max(0, (a.Height - size.Y) / 2));
     }
 
