+    /// <summary>The mode the window is currently presenting in.</summary>
+    public static WindowMode DisplayMode { get; private set; } = WindowMode.Windowed;
+
+    private readonly record struct WorkArea(int X, int Y, int Width, int Height);
+
+    /// <summary>
+    /// Work area read before the window exists.
+    /// </summary>
+    /// <remarks>
+    /// The windowing backend has not initialised glfw yet at this point, so this
+    /// initialises it directly. glfwInit is reference counted and returns true when
+    /// already initialised, so the backend's own call afterwards is a no-op; this
+    /// must therefore never call glfwTerminate, which would tear the shared instance
+    /// out from under the backend.
+    /// </remarks>
+    private static unsafe WorkArea? QueryWorkArea()
+    {
+        try
+        {
+            var glfw = Silk.NET.GLFW.Glfw.GetApi();
+            if (!glfw.Init()) return null;
+            var monitor = glfw.GetPrimaryMonitor();
+            if (monitor == null) return null;
+            glfw.GetMonitorWorkarea(monitor, out var x, out var y, out var w, out var h);
+            if (w <= 0 || h <= 0) return null;
+            return new WorkArea(x, y, w, h);
+        }
+        catch (Exception e)
+        {
+            Console.WriteLine($"[Host] monitor work area unavailable: {e.Message}");
+            return null;
+        }
+    }
+
+    /// <summary>
+    /// The size and position a window should be created with.
+    /// </summary>
+    /// <remarks>
+    /// Precedence is: this launch's command line, then a size the player chose
+    /// before, then the monitor. "Then the monitor" is what makes a first run correct
+    /// on a display the port has never seen - the old fixed 1280x720 opened
+    /// partly off-screen on anything narrower, and a window whose title bar is off
+    /// the desktop cannot be dragged back. A saved size is honoured but still
+    /// clamped, so a window saved on a 4K panel cannot open off-screen on a laptop.
+    /// </remarks>
+    private static (Vector2D<int> Size, Vector2D<int> Position) ResolveStartGeometry(
+        WindowMode mode, int? requestedWidth, int? requestedHeight, WorkArea? area)
+    {
+        // Exclusive fullscreen decides its own bounds; anything else is a suggestion
+        // the backend would fight with.
+        if (mode == WindowMode.Fullscreen) return (new Vector2D<int>(1280, 720), new Vector2D<int>(0, 0));
+
+        if (mode == WindowMode.Borderless)
+        {
+            // Filling the work area is the whole point of the mode, so any requested
+            // size is ignored here rather than silently producing a smaller
+            // "borderless" window.
+            if (area is { } borderless)
+                return (new Vector2D<int>(borderless.Width, borderless.Height),
+                        new Vector2D<int>(borderless.X, borderless.Y));
+            var fallback = requestedWidth is { } fw && requestedHeight is { } fh
+                ? new Vector2D<int>(fw, fh)
+                : new Vector2D<int>(1280, 720);
+            return (fallback, new Vector2D<int>(0, 0));
+        }
+
+        var size = requestedWidth is { } w && requestedHeight is { } h
+            ? FitToWorkArea(w, h, area)
+            : FillWorkArea(area);
+
+        var position = area is { } a
+            ? new Vector2D<int>(
+                a.X + Math.Max(0, (a.Width - size.X) / 2),
+                a.Y + Math.Max(0, (a.Height - size.Y) / 2))
+            : new Vector2D<int>(0, 0);
+
+        return (size, position);
+    }
+
+    /// <summary>
+    /// Switches the live window to another display mode.
+    /// </summary>
+    /// <remarks>
+    /// Used for runtime mode changes from the settings UI. Launch geometry does not
+    /// come through here - it is resolved before the window is created, because a
+    /// window that grows after the first frame leaves the ImGui dock layout sized for
+    /// the old viewport. See the comment in <c>Initialize</c>.
+    /// </remarks>
+    public static void SetDisplayMode(WindowMode mode, int? width = null, int? height = null)
+    {
+        if (_headless || _window == null) return;
+
+        var area = QueryWorkArea();
+        var requestedWidth = width ?? WindowRequest.Width;
+        var requestedHeight = height ?? WindowRequest.Height;
+
+        switch (mode)
+        {
+            case WindowMode.Borderless:
+                // Leave fullscreen before touching the border: asking a fullscreen
+                // window to go hidden-border is backend-dependent and can leave it
+                // stuck covering the monitor with no way back.
+                if (_window.WindowState != WindowState.Normal) _window.WindowState = WindowState.Normal;
+                _window.WindowBorder = WindowBorder.Hidden;
+                SetAutoIconify(false);
+                if (area is { } borderless)
+                {
+                    _window.Position = new Vector2D<int>(borderless.X, borderless.Y);
+                    _window.Size = new Vector2D<int>(borderless.Width, borderless.Height);
+                }
+                else
+                {
+                    _window.Size = requestedWidth is { } bw && requestedHeight is { } bh
+                        ? FitToWorkArea(bw, bh, null)
+                        : new Vector2D<int>(1280, 720);
+                    CenterOnWorkArea(null, _window.Size);
+                }
+
+                break;
+
+            case WindowMode.Fullscreen:
+                _window.WindowBorder = WindowBorder.Resizable;
+                _window.WindowState = WindowState.Fullscreen;
+                SetAutoIconify(false);
+                break;
+
+            default:
+                _window.WindowState = WindowState.Normal;
+                _window.WindowBorder = WindowBorder.Resizable;
+                // Coming back from fullscreen or borderless the window has no usable
+                // size of its own, so one is derived rather than restored.
+                var fit = requestedWidth is { } fw && requestedHeight is { } fh
+                    ? FitToWorkArea(fw, fh, area)
+                    : FillWorkArea(area);
+                _window.Size = fit;
+                CenterOnWorkArea(area, fit);
+                break;
+        }
+
+        DisplayMode = mode;
+        ConfigManager.View.DisplayMode = mode;
+        RequestLayout();
+        Console.WriteLine($"[Host] display mode: {mode} ({_window.Size.X}x{_window.Size.Y})");
+    }
+
+    /// <summary>
+    /// Shrinks a requested size until it fits inside the work area.
+    /// </summary>
+    /// <remarks>
+    /// The 92% margin is what keeps the title bar reachable and stops a window from
+    /// opening underneath the taskbar. A window larger than the screen is the
+    /// failure this replaces: at 1280x720 the port opened partly off-screen on any
+    /// display narrower than that, and a hidden title bar cannot be dragged back.
+    /// </remarks>
+    private static Vector2D<int> FitToWorkArea(int width, int height, WorkArea? area)
+    {
+        if (area is not { } a) return new Vector2D<int>(width, height);
+
+        var maxWidth = Math.Max(320, (int)(a.Width * 0.92));
+        var maxHeight = Math.Max(240, (int)(a.Height * 0.92));
+        var scale = Math.Min(1.0, Math.Min((double)maxWidth / width, (double)maxHeight / height));
+        return new Vector2D<int>(
+            Math.Max(320, (int)Math.Round(width * scale)),
+            Math.Max(240, (int)Math.Round(height * scale)));
+    }
+
+    /// <summary>
+    /// A sensible windowed size for a display nobody has told us about yet.
+    /// </summary>
+    /// <remarks>
