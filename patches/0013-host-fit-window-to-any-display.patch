+namespace RecompOne.Runtime.Config;
+
+/// <summary>
+/// How the host window presents itself on the desktop.
+/// </summary>
+public enum WindowMode
+{
+    /// <summary>A normal resizable window.</summary>
+    Windowed,
+
+    /// <summary>
+    /// An undecorated window covering the monitor's work area.
+    /// </summary>
+    /// <remarks>
+    /// This is the mode that behaves identically on every display. It performs no
+    /// mode switch, so it cannot pick a resolution the monitor does not support,
+    /// it leaves the desktop compositor in charge (so alt-tab, overlays and
+    /// multi-monitor still work), and it fills ultrawide and HiDPI screens exactly
+    /// as it fills a 1080p one. Exclusive fullscreen asks the driver to change
+    /// display mode instead, which is where "it broke on my monitor" usually
+    /// comes from.
+    /// </remarks>
+    Borderless,
+
+    /// <summary>Exclusive fullscreen, driven by the windowing backend.</summary>
+    Fullscreen
+}
+
+/// <summary>
+/// One-launch window geometry asked for by the host application.
+/// </summary>
+/// <remarks>
+/// This exists because <see cref="ConfigManager.View"/> is re-read from
+/// <c>interface.ini</c> inside <c>HostWindow.Initialize</c>, which would discard a
+/// value the host set in memory beforehand. These are process-level statics rather
+/// than persisted settings on purpose: a command-line override should apply to the
+/// launch it was given on and not silently become the player's saved preference.
+/// </remarks>
+public static class WindowRequest
+{
+    /// <summary>Mode to use for this launch, or null to use the saved setting.</summary>
+    public static WindowMode? Mode { get; set; }
+
+    /// <summary>Requested window width, or null to derive one from the monitor.</summary>
+    public static int? Width { get; set; }
+
+    /// <summary>Requested window height, or null to derive one from the monitor.</summary>
+    public static int? Height { get; set; }
+
+    public static void Clear()
+    {
+        Mode = null;
+        Width = null;
+        Height = null;
+    }
+}
