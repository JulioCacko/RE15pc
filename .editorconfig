root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{cs,csproj,props,targets,sln}]
indent_size = 4
end_of_line = crlf

[*.{json,md,yml,yaml}]
indent_size = 2

[*.{ps1,psm1}]
indent_size = 4
end_of_line = crlf

[*.patch]
indent_size = 4
trim_trailing_whitespace = false

[.githooks/*]
indent_size = 4
end_of_line = lf

[*.{bin,chd,png,ttf,otf}]
insert_final_newline = false
